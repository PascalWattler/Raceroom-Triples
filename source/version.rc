// File properties of the DLL (right-click, Properties, Details in Windows
// Explorer). They let a user tell this d3d9.dll apart from other wrappers.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION RRT_VERSION_MAJOR, RRT_VERSION_MINOR, 0, 0
PRODUCTVERSION RRT_VERSION_MAJOR, RRT_VERSION_MINOR, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Pascal Wattler"
            VALUE "FileDescription", "RaceRoom Triples - Direct3D 9 wrapper"
            VALUE "FileVersion", RRT_VERSION
            VALUE "InternalName", "d3d9"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "d3d9.dll"
            VALUE "ProductName", "RaceRoom Triples"
            VALUE "ProductVersion", RRT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
